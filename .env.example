# ===== Orbyn Tickets v1.6.0 — configuração =====
# Renomeie este arquivo para .env e preencha.

# --- Obrigatórias ---
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# --- Visual e modelo ---
# Modelos: store (loja), community, roleplay, corporation
TICKET_MODEL=store
SERVER_NAME=Meu Servidor
BOT_NAME=Atendimento
BOT_ROLE_NAME=Atendimento
BRAND_COLOR=#5865F2
TRANSCRIPT_TIME_ZONE=America/Sao_Paulo

# --- Limites ---
# Acima de ~47 tickets, o bot cria categorias extras (ATENDIMENTO 2, 3...).
MAX_OPEN_TICKETS=75
MAX_OPEN_TICKETS_PER_USER=1
TICKET_SUBMIT_COOLDOWN_SECONDS=60

# --- Inatividade (use 0 para desligar) ---
TICKET_INACTIVITY_WARNING_HOURS=12
TICKET_INACTIVITY_CLOSE_HOURS=12
TICKET_STAFF_REMINDER_HOURS=2

# --- Transcript ---
SEND_TRANSCRIPT_TO_USER=true
